{
  "name": "the-last-bell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "lint": "prettier --check src tests vite.config.ts index.html package.json tsconfig.json docs README.md",
    "format": "prettier --write src tests vite.config.ts index.html package.json tsconfig.json docs README.md"
  },
  "dependencies": {
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/three": "^0.181.0",
    "playwright": "^1.56.1",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
